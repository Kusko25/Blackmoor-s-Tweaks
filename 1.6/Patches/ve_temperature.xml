<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Vanilla Temperature Expanded</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="VTE_IndustrialHeater"]/building</xpath>
                    <value>
                        <isAirtight>true</isAirtight>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="VTE_IndustrialCooler"]/building</xpath>
                    <value>
                        <isAirtight>true</isAirtight>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="VTE_WallHeater"]/building</xpath>
                    <value>
                        <isAirtight>true</isAirtight>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="VTE_ACUnit"]</xpath>
                    <value>
                        <building>
                            <isAirtight>true</isAirtight>
                        </building>
                    </value>
                </li>
            </operations>
        </match>
    </Operation>
</Patch>
