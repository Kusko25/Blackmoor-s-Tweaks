<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/QuestScriptDef[defName="PollutionDump"]/rootSelectionWeight</xpath>
        <value>
            <rootSelectionWeight>0</rootSelectionWeight>
        </value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/QuestScriptDef[defName="PollutionDump"]</xpath>
        <value>
            <isRootSpecial>true</isRootSpecial>
        </value>
    </Operation>
</Patch>