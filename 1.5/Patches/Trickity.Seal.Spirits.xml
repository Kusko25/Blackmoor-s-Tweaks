<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <Operation Class="XmlExtensions.FindMod">
        <mods>
            <li>Trickity.Seal.Spirits</li>
        </mods>
        <packageId>true</packageId>
        <caseTrue>
            <Operation Class="XmlExtensions.OptionalPatch">
                <modId>Blackmoor.BlackmoorsTweaks</modId>
                <key>bt_tss_CauldronSerumLab</key>
                <!--By default, apply the patch-->
                <defaultValue>true</defaultValue>
                <caseTrue>
                    <Operation Class="XmlExtensions.Conditional">
                        <xpath>Defs/ThingDef[defName="T_Cauldron"]/modExtensions</xpath>
                        <caseTrue>
                            <Operation Class="XmlExtensions.PatchOperationAdd">
                                <xpath>Defs/ThingDef[defName="T_Cauldron"]/modExtensions</xpath>
                                <value>
                                    <li Class="RecipeInheritance.ThingDefExtension">
                                        <inheritRecipesFrom>
                                            <li>SerumCentrifuge</li>
                                        </inheritRecipesFrom>
                                    </li>
                                </value>
                            </Operation>
                        </caseTrue>
                        <caseFalse>
                            <Operation Class="XmlExtensions.PatchOperationAdd">
                                <xpath>Defs/ThingDef[defName="T_Cauldron"]</xpath>
                                <value>
                                    <modExtensions>
                                        <li Class="RecipeInheritance.ThingDefExtension">
                                            <inheritRecipesFrom>
                                                <li>SerumCentrifuge</li>
                                            </inheritRecipesFrom>
                                        </li>
                                    </modExtensions>
                                </value>
                            </Operation>
                        </caseFalse>
                    </Operation>
                </caseTrue>
            </Operation>
            <Operation Class="XmlExtensions.OptionalPatch">
                <modId>Blackmoor.BlackmoorsTweaks</modId>
                <key>bt_tss_ExpensiveCauldron</key>
                <defaultValue>true</defaultValue>
                <caseTrue>
                    <Operation Class="XmlExtensions.PatchOperationAdd">
                        <xpath>Defs/ThingDef[defName="T_Cauldron"]/costList</xpath>
                        <value>
                            <Bioferrite>80</Bioferrite>
                            <Shard>1</Shard>
                        </value>
                    </Operation>
                </caseTrue>
            </Operation>
            <Operation Class="XmlExtensions.OptionalPatch">
                <modId>Blackmoor.BlackmoorsTweaks</modId>
                <key>bt_tss_SlowCauldron</key>
                <defaultValue>true</defaultValue>
                <caseTrue>
                    <Operation Class="XmlExtensions.PatchOperationAdd">
                        <xpath>Defs/ThingDef[defName="T_Cauldron"]/statBases</xpath>
                        <value>
                            <WorkTableWorkSpeedFactor>0.5</WorkTableWorkSpeedFactor>
                        </value>
                    </Operation>
                </caseTrue>
            </Operation>
            <Operation Class="XmlExtensions.OptionalPatch">
                <modId>Blackmoor.BlackmoorsTweaks</modId>
                <key>bt_tss_RitualIncense</key>
                <defaultValue>true</defaultValue>
                <caseTrue>
                    <Operation Class="XmlExtensions.PatchOperationAdd">
                        <xpath>Defs/ThingDef[defName="T_Cauldron"]/comps</xpath>
                        <value>
                            <li Class="CompProperties_AffectedByFacilities">
                                <linkableFacilities>
                                    <li>T_BuldingRitualIncense</li>
                                </linkableFacilities>
                            </li>
                        </value>
                    </Operation>
                </caseTrue>
                <caseFalse>
                    <Operation Class="XmlExtensions.PatchOperationRemove">
                        <xpath>Defs/ThingDef[defName="T_BuldingRitualIncense"]</xpath>
                    </Operation>
                </caseFalse>
            </Operation>
        </caseTrue>
    </Operation>
</Patch>