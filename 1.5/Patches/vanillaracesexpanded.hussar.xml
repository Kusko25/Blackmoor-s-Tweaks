<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <Operation Class="XmlExtensions.FindMod">
        <mods>
            <li>vanillaracesexpanded.hussar</li>
        </mods>
        <packageId>true</packageId>
        <caseTrue>
            <Operation Class="XmlExtensions.OptionalPatch">
                <modId>Blackmoor.BlackmoorsTweaks</modId>
                <key>bt_vre_hussar_femOnly</key>
                <!--By default, apply the patch-->
                <defaultValue>true</defaultValue>
                <caseTrue>
                    <Operation Class="XmlExtensions.PatchOperationAdd">
                        <xpath>Defs/XenotypeDef[defName="Hussar" or defName="VREH_Uhlan"]/genes</xpath>
                        <value>
                            <li MayRequire="vanillaracesexpanded.phytokin" Name="AlphaGenesSwap">VRE_Female</li>
                        </value>
                    </Operation>
                </caseTrue>
            </Operation>
        </caseTrue>
        <caseFalse>
            <Operation Class="XmlExtensions.PatchOperationRemove">
                <xpath>Defs/XmlExtensions.SettingsMenuDef[modId="Blackmoor.BlackmoorsTweaks"]/settings/li[tag="ve_rHussar"]</xpath>
            </Operation>
        </caseFalse>
    </Operation>
</Patch>