<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <Operation Class="XmlExtensions.FindMod">
        <mods>
            <li>ElderSign.DBHforMedieval</li>
        </mods>
        <packageId>true</packageId>
        <caseTrue>
            <Operation Class="XmlExtensions.OptionalPatch">
                <modId>Blackmoor.BlackmoorsTweaks</modId>
                <key>bt_dfm_reduceSluiceDrain</key>
                <!--By default, apply the patch-->
                <defaultValue>true</defaultValue>
                <caseTrue>
                    <Operation Class="XmlExtensions.UseSetting">
                        <modId>Blackmoor.BlackmoorsTweaks</modId>
                        <key>bt_dfm_reduceSluiceDrain_Value</key>
                        <defaultValue>0.08</defaultValue>
                        <apply>
                            <Operation Class="XmlExtensions.PatchOperationReplace">
                                <xpath>Defs/ThingDef[defName="ES_SluiceGate"]/comps/li[@Class="DubsBadHygiene.CompProperties_Sprinkler"]/usagePerCell</xpath>
                                <value>
                                    <usagePerCell>{bt_dfm_reduceSluiceDrain_Value}</usagePerCell>
                                </value>
                            </Operation>
                        </apply>
                    </Operation>
                </caseTrue>
            </Operation>
        </caseTrue>
    </Operation>
</Patch>