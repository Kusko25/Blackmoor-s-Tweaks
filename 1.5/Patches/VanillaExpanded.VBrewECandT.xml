<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <Operation Class="XmlExtensions.FindMod">
        <mods>
            <li>VanillaExpanded.VBrewECandT</li>
        </mods>
        <packageId>true</packageId>
        <caseTrue>
            <Operation Class="XmlExtensions.OptionalPatch">
                <modId>Blackmoor.BlackmoorsTweaks</modId>
                <key>bt_vbe_allowDrinksAtBrewery</key>
                <!--By default, apply the patch-->
                <defaultValue>true</defaultValue>
                <caseTrue>
                    <Operation Class="XmlExtensions.PatchOperationSafeAdd">
                        <xpath>Defs/RecipeDef/recipeUsers[li="VBE_EspressoMachineBuilding"]</xpath>
                        <compare>InnerText</compare>
                        <value>
                            <li>Brewery</li>
                        </value>
                    </Operation>
                </caseTrue>
            </Operation>
        </caseTrue>
    </Operation>
</Patch>